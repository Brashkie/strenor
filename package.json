{
  "name": "strenor",
  "version": "0.0.1-alpha.0",
  "description": "Embedded high-performance key-value store for Node.js, powered by Rust. In-process, no server, no config.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "*.node", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "build:native": "echo \"build the Rust addon with Vekziun (manifest: Cargo.toml (root)) and place strenor.node at the package root\" && exit 1",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "presmoke": "tsup",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "tsup"
  },
  "keywords": ["kv", "key-value", "cache", "embedded", "in-memory", "rust", "napi", "store", "ttl"],
  "author": "Hepein Oficial (Brashkie)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brashkie/strenor.git"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "tag": "alpha"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
