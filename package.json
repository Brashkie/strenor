{
  "name": "strenor",
  "version": "0.2.0",
  "description": "Embedded high-performance key-value store for Node.js, powered by Rust. In-process, no server, no config.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE",
    "ROADMAP.md",
    "ECOSYSTEM.md",
    "CHANGELOG.md",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "napi build --platform --release --js false --cargo-cwd crates/strenor-node",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "presmoke": "tsup",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "tsup",
    "build:native:debug": "napi build --platform --js false --cargo-cwd crates/strenor-node",
    "build:ts": "tsup",
    "artifacts": "napi artifacts -d artifacts",
    "version:native": "napi version",
    "example:basic": "node examples/basic.mjs",
    "example:cache": "node examples/cache.mjs",
    "example:session": "node examples/session-store.mjs",
    "example:codec": "node examples/codec.mjs",
    "examples": "npm run example:basic && npm run example:cache && npm run example:session && npm run example:codec && npm run example:queue && npm run example:durability",
    "create-npm-dirs": "napi create-npm-dir -t .",
    "test:rust": "cargo test -p strenor-store",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "format:rust": "cargo fmt --all",
    "example:queue": "node examples/queue.mjs",
    "example:durability": "node examples/durability.mjs"
  },
  "keywords": ["kv", "key-value", "cache", "embedded", "in-memory", "rust", "napi", "store", "ttl"],
  "author": "Hepein Oficial (Brashkie)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brashkie/strenor.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@napi-rs/cli": "^2.18.4",
    "cross-env": "^7.0.3"
  },
  "napi": {
    "name": "strenor",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-linux-android",
        "armv7-linux-androideabi"
      ]
    },
    "package": {
      "name": "@strenor/binary"
    }
  },
  "optionalDependencies": {
    "@strenor/binary-win32-x64-msvc": "0.2.0",
    "@strenor/binary-darwin-x64": "0.2.0",
    "@strenor/binary-linux-x64-gnu": "0.2.0",
    "@strenor/binary-linux-x64-musl": "0.2.0",
    "@strenor/binary-linux-arm64-gnu": "0.2.0",
    "@strenor/binary-linux-arm64-musl": "0.2.0",
    "@strenor/binary-darwin-arm64": "0.2.0",
    "@strenor/binary-win32-arm64-msvc": "0.2.0",
    "@strenor/binary-android-arm64": "0.2.0",
    "@strenor/binary-android-arm-eabi": "0.2.0"
  }
}
